{
  "name": "research-paper-tracker",
  "version": "1.0.0",
  "description": "Track and discover trending research papers for content creation",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "papers": "ts-node scripts/fetch-papers.ts",
    "papers:trending": "ts-node scripts/fetch-papers.ts trending",
    "papers:search": "ts-node scripts/fetch-papers.ts search",
    "papers:recent": "ts-node scripts/fetch-papers.ts recent",
    "papers:skills": "ts-node scripts/fetch-papers-by-skills.ts",
    "post:compile": "ts-node scripts/compile-post.ts",
    "post:validate": "ts-node scripts/compile-post.ts --validate",
    "post:analyze": "ts-node scripts/compile-post.ts --analyze"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "James Levine",
  "license": "MIT"
}
