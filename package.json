{
  "name": "linkedin-automation",
  "version": "1.0.0",
  "description": "Automated LinkedIn post generation and publishing using AWS serverless architecture",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "setup:secrets": "ts-node scripts/setup-secrets.ts",
    "setup:oauth": "ts-node scripts/oauth-setup.ts",
    "setup:config": "ts-node scripts/setup-config.ts",
    "trigger": "ts-node scripts/trigger-workflow.ts",
    "deploy": "sam build && sam deploy --guided",
    "deploy:dev": "sam build && sam deploy --config-env dev",
    "deploy:prod": "sam build && sam deploy --config-env prod"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.500.0",
    "@aws-sdk/client-cloudformation": "^3.500.0",
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/client-secrets-manager": "^3.500.0",
    "@aws-sdk/client-ses": "^3.980.0",
    "@aws-sdk/client-sfn": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "axios": "^1.6.0",
    "dayjs": "^1.11.10",
    "rss-parser": "^3.13.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.19.10",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "James Levine",
  "license": "MIT"
}
